+            if key not in oni_table:
+                raise RuntimeError(
+                    f"Missing ONI row for {season} {wy + year_offset}; cannot classify WY{wy}."
+                )
+            components.append(oni_table[key])
+        out[wy] = statistics.fmean(components)
+    return out
 
